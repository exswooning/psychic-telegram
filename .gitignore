__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Runtime state — regenerated by the engine, never hand-edited
migration.db
migration.db-shm
migration.db-wal
migration.db-journal
migration.log
*.log
scratch/

# Seeder output. The manifests and identity CSVs carry real user addresses and
# Drive file IDs for the tenants that were seeded, so the globs matter as much
# as the exact names -- retries write sandbox_manifest_<something>.json, and a
# second batch writes identities_<something>.csv.
sandbox_manifest*.json
identities*.csv

# ----------------------------------------------------------------------
# Credentials. Nothing below here should ever leave the machine.
# ----------------------------------------------------------------------
# Service-account keys: each one can read every mailbox in its tenant.
keys/
*.json.key
client_secret*.json

# OAuth refresh tokens are long-lived and carry every consented scope --
# exactly as sensitive as a key, and easier to overlook because the directory
# is created on demand rather than by hand.
oauth/
*-token.json

# Backups the UI writes when a credential is replaced.
*.bak

# env.sh holds domains, admin addresses and absolute paths for a specific
# deployment. Not a credential, but it is somebody's real configuration and
# there is no reason to publish it.
env.sh
