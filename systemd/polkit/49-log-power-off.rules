// Bitport: log who asks to power off or reboot this always-on box (17 Nov 2026: two unexplained power-offs).
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.login1.power-off") == 0 || action.id.indexOf("org.freedesktop.login1.reboot") == 0) {
        polkit.log("POWER REQUEST " + action.id + " by user=" + subject.user + " pid=" + subject.pid + " local=" + subject.local + " active=" + subject.active + " session=" + subject.session);
    }
});
