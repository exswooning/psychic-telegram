[Unit]
Description=Bitport control plane API (api_server.py, port 8090)
After=network.target xvfb.service

[Service]
WorkingDirectory=/root/migration
Environment=DISPLAY=:99
# CP_OPERATORS is deliberately NOT set here.
#
# It maps an X-Operator header to a role, and a name is not a secret. With
# CP_OPERATORS=aryan:admin on a publicly reachable host, anyone who sent
# `X-Operator: aryan` was an admin on every route gated by require_admin.
# Empty, _roles() matches nobody, so the header grants nothing and the
# session cookie is the only credential -- which is what the browser has
# been using all along (operator() prefers the cookie over the header, and
# the SPA sends an empty header unless someone sets cp_operator in
# localStorage).
#
# Setting it is now safe but still not enough on its own: the X-Operator
# claim is only honoured when the request also presents X-Operator-Token
# matching BITPORT_OPERATOR_TOKEN, the same shape worker nodes use with
# BITPORT_NODE_TOKEN. With no token configured the header grants nothing at
# all, which is the state this host is in.
#
# To use the SSH-tunnel operator path, set BOTH here:
#   Environment=CP_OPERATORS=alice:admin
#   Environment=BITPORT_OPERATOR_TOKEN=<a real secret, not a name>
# secure=True on the session cookie only makes sense once this is actually
# reached over real HTTPS (Caddy, in front of this on 8090) -- see
# api_server.py's _set_session_cookie(). Left unset (defaulting to
# secure=False) anywhere this unit isn't the one being used, e.g. a bare
# `python3 api_server.py` run for local/tunnel-only testing.
Environment=BITPORT_COOKIE_SECURE=1
# The node token lives in a root-only file on the box, NOT here: this unit
# is rsynced from the repo on every deploy, so a secret written inline would
# be committed. The leading `-` makes the file optional, so a host that has
# never configured multi-node still starts.
EnvironmentFile=-/etc/bitport/node.env
ExecStart=/root/migration/.venv/bin/python api_server.py --port 8090
Restart=always
RestartSec=2
# Confirmed live: the default (KillMode=control-group) sends SIGTERM to
# EVERY process in this unit's cgroup on `systemctl restart` -- including
# detached grandchildren like full_setup.py/teardown_tenant.py, which are
# launched with subprocess's start_new_session=True specifically so they
# keep running across a redeploy. start_new_session only detaches from the
# controlling terminal/session; it does nothing to a process's cgroup
# membership, which is the separate mechanism control-group kill actually
# acts on. A real deploy mid-run silently killed a live tenant's DWD
# propagation wait this way, ~17 minutes in, with no error -- the process
# just stopped, no traceback, no final result written. KillMode=process
# restricts the kill to the tracked main PID only, which is what every
# comment in this codebase about "jobs survive a restart" already assumed
# was already true.
KillMode=process

[Install]
WantedBy=multi-user.target
