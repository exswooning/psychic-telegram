everything.nishantbohara.com.np {
	# api_server.py's own FastAPI routes, all under /api/v2/*, plus its
	# WebSocket hub -- everything else falls through to webui.py below.
	# One public origin for both servers means browser fetches between
	# them are same-origin and never touch CORS at all in normal use (see
	# api_server.py's allow_origin_regex, which still allows the tunnel
	# path as defense in depth, not as the primary route here).
	reverse_proxy /api/v2/* 127.0.0.1:8090
	reverse_proxy /ws 127.0.0.1:8090

	# webui.py: the SPA (redirects / -> /app), its own /api/* endpoints
	# (seed, job status, config -- unrelated to api_server.py's /api/v2/*),
	# and static assets.
	reverse_proxy /* 127.0.0.1:8080
}
